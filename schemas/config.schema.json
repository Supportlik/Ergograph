{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Supportlik/Ergograph/main/schemas/config.schema.json",
  "title": "Ergograph config.yaml",
  "description": "Build steering: person, languages, variants, documents, output paths.",
  "type": "object",
  "required": [
    "person",
    "languages",
    "content"
  ],
  "additionalProperties": false,
  "properties": {
    "person": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name in the document header."
        },
        "file_slug": {
          "type": "string",
          "description": "Slug for PDF file names; defaults to the name with hyphens."
        },
        "anonymous_slug": {
          "type": "string",
          "default": "profile",
          "description": "File-name slug of anonymous variants."
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Language codes to build; each needs an entry under 'content'."
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "description": "Path to the content file per language, relative to this file."
    },
    "variants": {
      "description": "Variant names, or a mapping name -> options. Defaults to ['default'].",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Extra tags for variants/except_variants/by_variant."
                  },
                  "anonymous": {
                    "type": "boolean",
                    "description": "No name, contact, photo or links."
                  },
                  "documents": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/document"
                    }
                  },
                  "photo": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "documents": {
      "description": "Documents to build: one list for all languages, or a list per language.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/document"
            }
          }
        }
      ]
    },
    "theme": {
      "type": "string",
      "default": "modern",
      "description": "Bundled theme name, or a path to a custom .css file."
    },
    "level_max": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 6,
      "description": "Upper end of the skill-bar scale."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html_dir": {
          "type": "string",
          "default": "html"
        },
        "pdf_dir": {
          "type": "string",
          "default": "pdf"
        },
        "date_prefix": {
          "type": "boolean",
          "default": true,
          "description": "Prefix file names with YYYY-MM-DD_."
        },
        "docx_dir": {
          "type": "string",
          "default": "docx",
          "description": "Output directory for DOCX files, relative to this file."
        },
        "docx_font": {
          "type": "string",
          "default": "Segoe UI",
          "description": "Base font of the generated DOCX documents."
        },
        "md_dir": {
          "type": "string",
          "default": "md"
        },
        "flat_dir": {
          "type": "string",
          "description": "Additionally copy every output into this one flat folder, variant and language in the file name."
        },
        "flat_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          },
          "description": "Only these documents go into flat_dir; default: all built documents."
        },
        "flat_by_format": {
          "type": "boolean",
          "default": false,
          "description": "One subfolder per format (pdf/, docx/, md/) inside flat_dir."
        }
      }
    },
    "chrome": {
      "type": "string",
      "description": "Chrome/Chromium binary, if it is not detected automatically."
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "pdf",
          "docx",
          "md"
        ]
      },
      "default": [
        "pdf"
      ],
      "description": "Output formats to write. HTML is always produced as the intermediate step; 'pdf' renders it via Chrome, 'docx' writes an Office Open XML document from the same content. 'md' writes a Markdown text version."
    },
    "photo": {
      "description": "Photo in the header: a path, or options.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "description": "JPEG or PNG, embedded unchanged."
            },
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/document"
              },
              "default": [
                "cv",
                "full",
                "onepager"
              ]
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Another file per document, e.g. {onepager: other.jpg}."
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "document": {
      "enum": [
        "cv",
        "projects",
        "skills",
        "full",
        "onepager"
      ]
    }
  }
}
